# /etc/caddy/Caddyfile on the Hetzner host. Cloudflare proxies pikku.dev to this machine.
# Cloudflare SSL/TLS mode: "Full (strict)". Caddy gets its certificate via the DNS challenge
# (needs the caddy-dns/cloudflare build) or use a Cloudflare Origin CA certificate:
#   tls /etc/caddy/origin.pem /etc/caddy/origin.key
pikku.dev, www.pikku.dev {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		health_uri /healthz
		health_interval 10s
	}
	log {
		output file /var/log/caddy/pikku.dev.log
	}
}
