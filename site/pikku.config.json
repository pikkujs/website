{
  "$schema": "https://raw.githubusercontent.com/pikkujs/pikku/refs/heads/main/packages/cli/cli.schema.json",
  "rootDir": ".",
  "tsconfig": "backend/tsconfig.json",
  "srcDirectories": [
    "backend/src"
  ],
  "outDir": "backend/.pikku",
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**"
  ],
  "schema": {
    "supportsImportAttributes": true
  },
  "clientFiles": {
    "rpcMapDeclarationFile": "src/pikku/rpc-map.gen.d.ts",
    "rpcWiringsFile": "src/pikku/pikku-rpc.gen.ts",
    "tanstackStartFile": "src/pikku/pikku-start.gen.ts",
    "fetchFile": "src/pikku/pikku-fetch.gen.ts"
  },
  "scaffold": {
    "pikkuDir": "backend/src/scaffold",
    "rpc": true
  }
}